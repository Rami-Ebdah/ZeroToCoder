{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=ZeroToCoder;Trusted_Connection=True;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "",
    "Issuer": "ZeroToCoder.Api",
    "Audience": "ZeroToCoder.Web",
    "ExpireMinutes": 1440
  },

  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },

  "FileStorage": {
    "RootPath": "Storage",
    "MaxCvSizeBytes": 5242880
  },

  "RateLimiting": {
    "AuthPermitPerMinute": 10
  }
}
